{
  "name": "Listening Log",
  "short_name": "Listening Log",
  "description": "Sonos + Spotify listening log and controller",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0a0e1a",
